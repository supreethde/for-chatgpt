rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Admin Authorization Check:
     * Checks if the authenticated user either has a custom claim `admin == true`
     * OR has a document in the Firestore `/users/{uid}` collection with `role == 'admin'`.
     * Note: Change `(default)` below to your custom firestore database ID if not using default.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isSupportedImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isWithinFileSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Product Images Path: products/{productId}/{fileName}
    match /products/{productId}/{fileName} {
      // Public read access for product catalog images
      allow read: if true;

      // Restrict upload & replacement to authorized admins only with strict file type and size constraints
      allow create, update: if isAdmin() 
        && isSupportedImageType() 
        && isWithinFileSizeLimit();

      // Restrict deletion to authorized admins only
      allow delete: if isAdmin();
    }

    // Deny access to any unapproved storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
