rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantName.size() <= 200
        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.size() <= 50;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
