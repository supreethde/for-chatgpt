rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Admin Authorization Check:
     * Matches the Firestore authorization strategy:
     * 1. Custom Auth claim (`request.auth.token.admin == true`), OR
     * 2. Firestore user profile check (`/users/{uid}` document with `role == 'admin'`).
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        )
      );
    }

    function isSupportedImageType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)');
    }

    function isWithinFileSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Product Images Path: products/ and any nested files under products/
    match /products/{filePath=**} {
      // Public read access for product catalog images
      allow read: if true;

      // Restrict upload & replacement to authorized admins only with file type and size constraints
      allow create, update: if isAdmin() 
        && isSupportedImageType() 
        && isWithinFileSizeLimit();

      // Restrict deletion to authorized admins only
      allow delete: if isAdmin();
    }

    // Deny access to any unapproved storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

