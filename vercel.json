{
  "redirects": [
    {
      "source": "/products/:slug",
      "destination": "/produce/:slug",
      "permanent": true
    },
    {
      "source": "/produce/category/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin.html"
    },
    {
      "source": "/gone/:slug",
      "destination": "/api/gone?slug=:slug"
    },
    {
      "source": "/shop",
      "destination": "/shop/index.html"
    },
    {
      "source": "/vegetables",
      "destination": "/vegetables/index.html"
    },
    {
      "source": "/fruits",
      "destination": "/fruits/index.html"
    },
    {
      "source": "/leafy-greens",
      "destination": "/leafy-greens/index.html"
    },
    {
      "source": "/microgreens",
      "destination": "/microgreens/index.html"
    },
    {
      "source": "/mushrooms",
      "destination": "/mushrooms/index.html"
    },
    {
      "source": "/exotics",
      "destination": "/exotics/index.html"
    },
    {
      "source": "/produce/:slug",
      "destination": "/produce/:slug/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
